# API Keys

# xAI Grok API key for REAL LLM interviews (optional - works in mock mode without this)
# Get from: https://console.x.ai/
# When set, The Gate will use live AI interviews instead of mock scripts
XAI_API_KEY=your_xai_api_key_here

# GitHub token for higher rate limits (optional)
# Generate at: https://github.com/settings/tokens
# Without this, unauthenticated API works but has lower rate limits
GITHUB_TOKEN=your_github_token_here

# Cognee memory layer (optional, not yet implemented)
COGNEE_ENABLED=false
