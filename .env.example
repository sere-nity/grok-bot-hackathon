# API Keys (all optional - app works in mock mode without these)

# xAI Grok API key for real LLM interviews
# Get from: https://console.x.ai/
XAI_API_KEY=your_xai_api_key_here

# GitHub token for higher rate limits (optional)
# Generate at: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here

# Cognee memory layer (optional, not yet implemented)
COGNEE_ENABLED=false
